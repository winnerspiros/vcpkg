{
  "name": "mixxx",
  "version": "2.5.0",
  "description": "Mixxx is free cross platform DJ software",
  "homepage": "https://mixxx.org/",
  "license": "GPL-2.0-or-later",
  "supports": "!uwp",
  "default-features": [
    "qt6"
  ],
  "features": {
    "qt5": {
      "description": "Build with Qt 5",
      "dependencies": [
        "qt5-base",
        "qt5-declarative",
        "qt5-script",
        "qt5-svg",
        "qt5-translations",
        "qtkeychain"
      ]
    },
    "qt6": {
      "description": "Build with Qt 6",
      "dependencies": [
        "qt5compat",
        {
          "name": "qtbase",
          "features": [
            "shared-mime-info"
          ],
          "platform": "!android"
        },
        {
          "name": "qtbase",
          "default-features": false,
          "platform": "android",
          "features": [
            "appstore-compliant",
            "brotli",
            "concurrent",
            "dnslookup",
            "doubleconversion",
            "egl",
            "freetype",
            "gles2",
            "gui",
            "harfbuzz",
            "icu",
            "jpeg",
            "network",
            "opengl",
            "openssl",
            "pcre2",
            "png",
            "shared-mime-info",
            "sql",
            "sql-sqlite",
            "testlib",
            "thread",
            "widgets",
            "zstd",
            "vulkan"
          ]
        },
        {
          "name": "qtbase",
          "host": true,
          "default-features": false,
          "platform": "android",
          "features": [
            "concurrent",
            "doubleconversion",
            "gui",
            "network",
            "png",
            "sql",
            "testlib",
            "thread",
            "widgets"
          ]
        },
        {
          "name": "qtbase",
          "features": [
            "vulkan"
          ],
          "platform": "!osx & !ios & !android"
        },
        "qtdeclarative",
        {
          "name": "qtmultimedia",
          "features": [
            "qml"
          ],
          "platform": "!android"
        },
        {
          "name": "qtmultimedia",
          "default-features": false,
          "features": [
            "ffmpeg",
            "qml"
          ],
          "platform": "android"
        },
        {
          "name": "qtapplicationmanager",
          "platform": "!android"
        },
        {
          "name": "qtsvg",
          "features": [
            "widgets"
          ]
        },
        "qttranslations",
        "qtkeychain-qt6"
      ]
    }
  },
  "dependencies": [
    {
      "name": "7zip",
      "platform": "!android"
    },
    "ableton-link",
    {
      "name": "benchmark",
      "platform": "!android"
    },
    {
      "name": "bit7z",
      "platform": "!android"
    },
    "chromaprint",
    "fdk-aac",
    {
      "name": "ffmpeg",
      "features": [
        "fedora-ffmpeg-free-safe",
        "ffmpeg"
      ],
      "platform": "!android"
    },
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swresample",
        "swscale",
        "fedora-ffmpeg-free-safe"
      ],
      "platform": "android"
    },
    "fftw3",
    {
      "name": "grantlee",
      "platform": "!android"
    },
    {
      "name": "gtest"
    },
    "hidapi",
    {
      "name": "hss1394",
      "platform": "windows | osx"
    },
    {
      "name": "libdjinterop",
      "platform": "!android"
    },
    "libebur128",
    "libflac",
    {
      "name": "libid3tag",
      "platform": "(!osx & !ios) & !android"
    },
    {
      "name": "libkeyfinder",
      "platform": "!android"
    },
    {
      "name": "libmad",
      "platform": "(!osx & !ios) & !android"
    },
    {
      "name": "liblo",
      "platform": "!android"
    },
    {
      "name": "libmodplug",
      "platform": "!android"
    },
    "libogg",
    {
      "name": "libopusenc",
      "platform": "!android"
    },
    "libsndfile",
    "libusb",
    "libvorbis",
    {
      "name": "lilv",
      "platform": "!android"
    },
    "mp3lame",
    "ms-gsl",
    "opus",
    "opusfile",
    {
      "name": "portaudio",
      "features": [
        "asio"
      ],
      "platform": "!android"
    },
    {
      "name": "portaudio",
      "default-features": false,
      "platform": "android"
    },
    {
      "name": "pipewire",
      "platform": "linux"
    },
    {
      "name": "portmidi",
      "platform": "!android"
    },
    "protobuf",
    "pthreads",
    {
      "name": "rubberband",
      "platform": "!android"
    },
    "soundtouch",
    "taglib",
    {
      "name": "upower",
      "platform": "linux"
    },
    {
      "name": "wavpack",
      "platform": "!android"
    }
  ]
}
